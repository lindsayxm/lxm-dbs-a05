# Copy to apps/web/.env (git-ignored). The server and the browser both read the board from Supabase
# with the public anon / publishable key; RLS limits it to SELECT on users, scores and worker_state.

# Project Settings -> Data API -> Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Project Settings -> API Keys -> anon public (legacy) or Publishable key
SUPABASE_ANON_KEY=
# The same two values again for the browser (Realtime socket). Inlined at build time.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Table names, if you renamed them (defaults shown).
# SUPABASE_USERS_TABLE=users
# SUPABASE_SCORES_TABLE=scores
# Fallback poll interval in ms (Realtime pushes arrive first).
# NEXT_PUBLIC_POLL_MS=15000

# Optional, never read by the app: lets `npm run push-check` invoke the worker and delete its test tap.
# Project Settings -> API Keys -> Secret keys
# SUPABASE_SECRET_KEY=
